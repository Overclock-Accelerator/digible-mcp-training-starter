# Copy this file to .env.local and fill in your key.
#   cp .env.local.example .env.local
#
# .env.local is gitignored. Every agent in this repo loads it automatically
# via shared/envloader.py -- you never need to export anything in your shell.

ANTHROPIC_API_KEY=sk-ant-...

# Only needed for 02/08 if you point the audit log at Postgres.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
